<!-- ===== WUJI HAND MOUNT (LEFT) =====
     Chain: EndEffector_Link -> wuji_mount_link -> hand_link -> palm_link.
       1. endeffector_to_wuji_mount_left: Kinova TCP -> wuji_mount origin.
          IK-absorbed. TODO: adjust xyz/rpy to match physical adapter CAD.
       2. mount_to_hand_left: wuji_mount -> hand_link IK frame. IK-absorbed.
       3. hand_to_palm_left: visual alignment of wuji palm frame to the
          xhand-convention hand_link frame. IK does NOT see this - tuning
          only changes how the hand mesh appears relative to commanded wrist
          poses. Adjust in viser until the palm looks right at zero rotation.
-->
  <link name="left_wuji_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wuji_mount.STL" scale="1 1 1"/>
      </geometry>
      <material name="wuji_mount_vis"><color rgba="0.82 0.82 0.82 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wuji_mount.STL" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <joint name="endeffector_to_wuji_mount_left" type="fixed">
    <parent link="EndEffector_Link"/>
    <child link="left_wuji_mount_link"/>
    <origin xyz="0 0 0" rpy="1.5700 0 0"/>
  </joint>
  <link name="left_hand_link"/>
  <joint name="mount_to_hand_left" type="fixed">
    <parent link="left_wuji_mount_link"/>
    <child link="left_hand_link"/>
    <origin xyz="0 0.0300 0" rpy="0 1.5700 1.5700"/>
  </joint>
  <joint name="hand_to_palm_left" type="fixed">
    <parent link="left_hand_link"/>
